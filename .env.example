# Configuración del Bot de Trading de Futuros
# Copia este archivo como .env y completa con tus datos reales

# Monetag Mini App URL (opcional)
MONETAG_MINI_APP_URL=https://omg10.com/4/10987049

# Bot de Telegram (Requerido)
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# API de Binance (Opcional, para endpoints autenticados)
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_SECRET_KEY=tu_secret_key_aqui

# Parámetros del Bot (Opcionales, tienen valores por defecto)
# Modo de trading: HYBRID (ambos), SCALPING (operaciones rápidas), SWING (tendencial)
TRADING_MODE=HYBRID

# Temporalidades para cada modalidad
SCALPING_TIMEFRAMES=5m,15m
SWING_TIMEFRAMES=1h,4h

# Intervalo entre escaneos en segundos (ej: 60 para scalping/hybrid, 300 para swing)
ANALYSIS_INTERVAL=60

# Configuración de Scalping (Operaciones rápidas 5m/15m)
SCALPING_MIN_PROBABILITY=75.0
SCALPING_COOLDOWN_MINUTES=10
SCALPING_STOP_LOSS_PERCENT=0.8
SCALPING_TAKE_PROFIT_PERCENT=1.6

# Configuración de Swing (Operaciones tendenciales 1h/4h)
MIN_PROBABILITY=80.0
SIGNAL_COOLDOWN_MINUTES=30
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=4.0

